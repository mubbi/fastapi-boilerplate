# Test environment — used by pytest in CI and locally via `make test`.
# Loaded by conftest.py guardrail to verify isolation from dev/prod DBs.
# Hostnames `postgres_test` / `redis_test` come from docker-compose.test.yml.

APP_NAME=fastapi-boilerplate
APP_ENV=test
APP_VERSION=0.1.0-test
APP_DEBUG=false
APP_LOG_LEVEL=WARNING
APP_LOG_FORMAT=console
APP_HOST=0.0.0.0
APP_PORT=8000
APP_API_V1_PREFIX=/api/v1
APP_CORS_ORIGINS=["http://localhost:3000"]
APP_CORS_ALLOW_CREDENTIALS=true
APP_REQUEST_TIMEOUT_SECONDS=30
APP_GRACEFUL_SHUTDOWN_SECONDS=5
APP_DOCS_ENABLED=true
APP_TRUSTED_HOSTS=["*"]
SERVICE_ROLE=web

SECRET_KEY=test-secret-key-not-for-production-use-only-32c
JWT_SECRET_KEY=test-jwt-secret-not-for-production-use-only-32c
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
AUTH_ENABLED=false
PASSWORD_MIN_LENGTH=12
RATE_LIMIT_DEFAULT=1000/minute
RATE_LIMIT_AUTH=100/minute

# Test DB / Redis — must contain "_test" so the conftest guardrail accepts them.
DATABASE_URL=postgresql+asyncpg://app_test:app_test@localhost:55432/app_test
DATABASE_URL_TEST=postgresql+asyncpg://app_test:app_test@localhost:55432/app_test
DATABASE__POOL_SIZE=5
DATABASE__MAX_OVERFLOW=5
DATABASE__POOL_TIMEOUT=10
DATABASE__POOL_RECYCLE_SECONDS=1800
DATABASE__ECHO=false
DATABASE__STATEMENT_TIMEOUT_MS=15000

REDIS_URL=redis://localhost:56379/0
REDIS_URL_TEST=redis://localhost:56379/0
REDIS__MAX_CONNECTIONS=10
REDIS__SOCKET_TIMEOUT=5
CACHE_DEFAULT_TTL_SECONDS=60

CELERY_BROKER_URL=redis://localhost:56379/1
CELERY_RESULT_BACKEND=redis://localhost:56379/2
CELERY_BROKER_URL_TEST=redis://localhost:56379/1
CELERY_RESULT_BACKEND_TEST=redis://localhost:56379/2
CELERY_TASK_ALWAYS_EAGER=true
CELERY_TASK_TIME_LIMIT=60
CELERY_TASK_SOFT_TIME_LIMIT=30
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_ACKS_LATE=true
CELERY_QUEUES=default,events
CELERY_BEAT_SCHEDULER=celery.beat.PersistentScheduler
CELERY_BEAT_SCHEDULE_FILENAME=
CELERY_CRON_LOCK_PREFIX=cron:lock
CELERY_CRON_LOCK_TTL_SECONDS=60

EMAIL_ENABLED=false
EMAIL_PROVIDER=null
EMAIL_FROM_ADDRESS=no-reply@example.test
EMAIL_FROM_NAME=Test
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_STARTTLS=false

HTTP_CLIENT__TIMEOUT_SECONDS=5
HTTP_CLIENT__MAX_KEEPALIVE=5
HTTP_CLIENT__MAX_CONNECTIONS=10
HTTP_CLIENT__RETRY_ATTEMPTS=1
HTTP_CLIENT__RETRY_BACKOFF_BASE=0.1

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=fastapi-boilerplate-test
OTEL_TRACES_SAMPLER=always_off
OTEL_TRACES_SAMPLER_ARG=0
PROMETHEUS_ENABLED=false
METRICS_ENDPOINT_AUTH_TOKEN=

LOCALES_ENABLED=["en","ar"]
LOCALE_DEFAULT=en
LOCALE_FALLBACK=en
LOCALE_QUERY_PARAM=lang
LOCALE_HEADER_NAME=Accept-Language
LOCALE_DOMAIN=messages
LOCALE_DIR=app/locales
RTL_LOCALES=["ar"]
LOCALE_TRANSLATION_COMPLETENESS_MIN=0.0
FEATURE_DEMO_ENABLED=false
