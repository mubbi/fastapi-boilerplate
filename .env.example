# Single source of truth for every env var the app reads.
# Copy to .env (auto-done by `make setup ENV=local`) and edit locally.
# Never commit real secrets — production uses Render Secret Manager.

# ── Application ──────────────────────────────────────────────
APP_NAME=fastapi-boilerplate
APP_ENV=local                       # local | dev | staging | production | test
APP_VERSION=0.1.0
APP_DEBUG=true
APP_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
APP_LOG_FORMAT=console              # json | console (console only for local)
APP_HOST=0.0.0.0
APP_PORT=8000
APP_API_V1_PREFIX=/api/v1
APP_CORS_ORIGINS=["http://localhost:3000"]
APP_CORS_ALLOW_CREDENTIALS=true
APP_REQUEST_TIMEOUT_SECONDS=30
APP_GRACEFUL_SHUTDOWN_SECONDS=20
APP_DOCS_ENABLED=true
APP_TRUSTED_HOSTS=["*"]
SERVICE_ROLE=web                    # web | worker | beat (production)

# ── Security ─────────────────────────────────────────────────
SECRET_KEY=change-me-min-32-chars-random-string
JWT_SECRET_KEY=change-me-min-32-chars-random-string
JWT_ALGORITHM=HS256
JWT_AUDIENCE=fastapi-boilerplate
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
AUTH_ENABLED=false
PASSWORD_MIN_LENGTH=12
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH=10/minute

# ── PostgreSQL (dev) ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/app_db
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=20
DATABASE__POOL_TIMEOUT=30
DATABASE__POOL_RECYCLE_SECONDS=1800
DATABASE__ECHO=false
DATABASE__STATEMENT_TIMEOUT_MS=15000

# ── PostgreSQL (test isolation) ──────────────────────────────
DATABASE_URL_TEST=postgresql+asyncpg://app_test:app_test@postgres_test:5432/app_test

# ── Redis (dev) ──────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS__MAX_CONNECTIONS=50
REDIS__SOCKET_TIMEOUT=5
CACHE_DEFAULT_TTL_SECONDS=300

# ── Redis (test) ─────────────────────────────────────────────
REDIS_URL_TEST=redis://redis_test:6379/0

# ── Celery (dev) ─────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_ACKS_LATE=true
CELERY_QUEUES=default,events
CELERY_BEAT_SCHEDULER=celery.beat.PersistentScheduler
CELERY_BEAT_SCHEDULE_FILENAME=
CELERY_CRON_LOCK_PREFIX=cron:lock
CELERY_CRON_LOCK_TTL_SECONDS=300

# ── Celery (test) ────────────────────────────────────────────
CELERY_BROKER_URL_TEST=redis://redis_test:6379/1
CELERY_RESULT_BACKEND_TEST=redis://redis_test:6379/2

# ── Email ────────────────────────────────────────────────────
EMAIL_ENABLED=true
EMAIL_PROVIDER=smtp                 # smtp | null
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=FastAPI Boilerplate
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_STARTTLS=false

# ── HTTP Client (outbound) ───────────────────────────────────
HTTP_CLIENT__TIMEOUT_SECONDS=10
HTTP_CLIENT__MAX_KEEPALIVE=20
HTTP_CLIENT__MAX_CONNECTIONS=100
HTTP_CLIENT__RETRY_ATTEMPTS=3
HTTP_CLIENT__RETRY_BACKOFF_BASE=0.5

# ── Observability ────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=fastapi-boilerplate
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
PROMETHEUS_ENABLED=true
METRICS_ENDPOINT_AUTH_TOKEN=

# ── i18n / l10n ──────────────────────────────────────────────
LOCALES_ENABLED=["en","ar"]
LOCALE_DEFAULT=en
LOCALE_FALLBACK=en
LOCALE_QUERY_PARAM=lang
LOCALE_HEADER_NAME=Accept-Language
LOCALE_DOMAIN=messages
LOCALE_DIR=app/locales
RTL_LOCALES=["ar"]
LOCALE_TRANSLATION_COMPLETENESS_MIN=0.95

# ── Feature flags ────────────────────────────────────────────
FEATURE_DEMO_ENABLED=false
